## CDF of the score
p2 <- ggplot(subobj@meta.data,
             aes(x = GeneModuleScore1, color = Group)) +
  stat_ecdf(linewidth = 2) +
  scale_color_manual(values = c("HC" = "#9bcac8", "EE" = "#ca94c3")) +
  labs(x = "PNN module score", y = "Cumulative fraction") +
