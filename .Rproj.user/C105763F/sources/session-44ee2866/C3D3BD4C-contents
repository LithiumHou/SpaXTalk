  theme_bw(base_size = 12)

# 加 KS test 结果
ks <- ks.test(
  subobj@meta.data$GeneModuleScore1[subobj@meta.data$Group == "HC"],
  subobj@meta.data$GeneModuleScore1[subobj@meta.data$Group == "EE"]
)
p2 + annotate("text", x = quantile(subobj@meta.data$GeneModuleScore1, 0.85),
    y = 0.4,
    label = paste0("KS D = ", round(ks$statistic, 3),
                   "\np = ", format(ks$p.value, scientific = TRUE)),
    hjust = 0)+
    theme(text = element_text(size = 18))
ggsave("E:/Scomics/Feng/otherdata/sn_0104/0608/GeneModuleScore_CDF.pdf", width = 6,height = 6)

# 重新 normalize + cluster GABA 细胞
subobj <- NormalizeData(subobj) %>%
  FindVariableFeatures() %>%
  ScaleData() %>%
  RunPCA(npcs = 20)
subobj <- FindNeighbors(subobj, dims = 1:15) %>%
  FindClusters(resolution = 0.1) %>%
  RunUMAP(dims = 1:15)

# 用 marker 注释 subcluster
FeaturePlot(subobj, features = c("Pvalb", "Sst", "Vip", "Lamp5","Erbb4"),pt.size = .5)
ggsave("E:/Scomics/Feng/otherdata/sn_0104/0608/subcluster_marker_GABA.pdf", width = 8,height = 6)
DimPlot(subobj, reduction = "umap",pt.size = 1)
ggsave("E:/Scomics/Feng/otherdata/sn_0104/0608/subcluster_GABA.pdf", width = 8,height = 6)

VlnPlot(subobj, features = c("Pvalb", "Sst", "Vip", "Lamp5"))
# 根据 marker 把 cluster ID 改成 subtype name
subobj <- RenameIdents(subobj, 
