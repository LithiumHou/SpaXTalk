library(Seurat)
library(ggplot2)
library(dplyr)
library(ggpubr)
library(effsize)
library(tidyr)

SeuratObj <- readRDS("E:/Scomics/Feng/otherdata/sn_0104/sn_0104.rds")

gene_set <- c("Acan", "Bcan", "Ncan", "Vcan","Hapln1", "Hapln4","Tnr","Ptprz1")   # replace with your gene set
gene_use <- "Erbb4"                               # gene to plot against module score
condition_col <- "Group"
conditions_use <- c("HC", "EE")

# Keep genes present in the object
gene_set_use <- intersect(gene_set, rownames(SeuratObj))
gene_use <- intersect(gene_use, rownames(SeuratObj))

# Add module score
SeuratObj <- AddModuleScore(
  object = SeuratObj,
  features = list(gene_set_use),
  name = "GeneModuleScore"
)

# Subset 到 GABA cluster 单独做比较
# AddModuleScore creates column GeneModuleScore1
score_col <- "GeneModuleScore1"
subobj <- subset(SeuratObj,celltype == "GABA")
# Extract expression and module score
df <- FetchData(
  subobj,
  vars = c(gene_use, score_col, condition_col)
)

colnames(df) <- c("gene_expr", "module_score", "condition")

df <- df %>%
  filter(condition %in% conditions_use)
c(mean(df[df$condition == "HC","module_score"]), mean(df[df$condition == "EE","module_score"]))
wilcox.test(gene_expr ~ condition, data = df)
wilcox.test(module_score ~ condition, data = df)
effsize::cohen.d(module_score ~ condition, data = df)

ggplot(df, aes(x = gene_expr, y = module_score, color = condition)) +
  geom_point(size = 1.2) +
  geom_smooth(method = "lm", se = TRUE) +
  facet_wrap(~condition, scales = "free") +
  ylim(-0.23, 1)+
  scale_color_manual(values = c("HC" = "#9bcac8", "EE" = "#ca94c3")) +
  labs(
    x = paste0(gene_use, " expression"),
    y = "Gene module score",
    color = "Condition"
  ) +
  theme_bw(base_size = 14) +
  theme(legend.position = "none")+
  theme(text = element_text(size = 18))
ggsave("E:/Scomics/Feng/otherdata/sn_0104/0608/GeneModuleScore_GABA.pdf", width = 8,height = 5)

df2 <- SeuratObj@meta.data
ggplot(df2, aes(x = celltype, y = GeneModuleScore1, fill = Group)) +
  # 半透明 violin 显示分布
  geom_violin(position = position_dodge(0.8),
              alpha = 0.55, scale = "width", trim = TRUE,
              color = NA) +
  # 内嵌 boxplot 显示中位数和四分位
  geom_boxplot(position = position_dodge(0.8),
               width = 0.15, outlier.shape = NA,
               color = "grey30", alpha = 0.85) +
  # 配色匹配 GA
  scale_fill_manual(values = c("HC" = "#9bcac8", "EE" = "#ca94c3"),
                    name = NULL) +
  # 显著性标注（per cell type）
  stat_compare_means(aes(group = Group),
                     method = "wilcox.test",
                     label = "p.signif",
                     hide.ns = FALSE,
                     label.y = max(df$GeneModuleScore1) * 1.05) +
  labs(x = NULL, y = "PNN gene module score") +
  theme_bw(base_size = 12) +
  theme(
    axis.text.x = element_text(angle = 0, hjust = 0.5),
    legend.position = "top"
  )+
  theme(text = element_text(size = 18))
ggsave("E:/Scomics/Feng/otherdata/sn_0104/0608/GeneModuleScore_all.pdf", width = 8,height = 6)

df3 <- df2[df2$celltype == "GABA", ]
