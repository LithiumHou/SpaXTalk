ggsave("E:/Scomics/Feng/otherdata/sn_0104/0608/subcluster_GABA_ModuleScore.pdf", width = 10,height = 6)

# DEG of subtype
pnn_genes <- c("Acan", "Bcan", "Ncan", "Vcan",
               "Hapln1", "Hapln4", "Tnr", "Ptprz1")

# Pseudobulk 每个基因
pb <- AggregateExpression(subobj, group.by = "Group",
                          features = pnn_genes,
                          slot = "counts")$RNA

# 算 log2 fold change
log2fc <- log2((pb[, "EE"] + 1) / (pb[, "HC"] + 1))

# 配合 per-gene Wilcoxon 算 p-value 然后做 heatmap
# （也可以用 Seurat::FindMarkers 一步做掉）
marker_pnn <- FindMarkers(subobj, ident.1 = "EE", ident.2 = "HC",
                          group.by = "Group",
                          features = pnn_genes,
                          logfc.threshold = 0,
                          min.pct = 0)
print(marker_pnn)

